# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Configuration
JWT_SECRET_KEY=iMEmKcy0379y9/W2cDgnAp+CPHIPavpI/KEqh7BEIdwRdW81PkpBOu8KRUi6CCE4JE7HABgqTzVn001VsKQtQw==
