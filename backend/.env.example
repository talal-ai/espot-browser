# ESPOT Browser API Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# SUPABASE CONFIGURATION (REQUIRED)
# =============================================================================
# Get these from your Supabase project dashboard > Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Supabase provides PostgreSQL, but you can also use external DB
DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres
# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here_minimum_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth (for admin authentication)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Security
SECRET_KEY=your_super_secret_key_here_minimum_32_characters
ALLOWED_HOSTS=localhost,127.0.0.1,*.localhost
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# REDIS CONFIGURATION (OPTIONAL)
# =============================================================================
# For caching, sessions, and background tasks
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_here

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
ENVIRONMENT=development

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/api.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =============================================================================
# PROXY CONFIGURATION
# =============================================================================
# Default proxy settings
DEFAULT_PROXY_TIMEOUT=30
DEFAULT_PROXY_RETRIES=3
PROXY_HEALTH_CHECK_INTERVAL=300

# =============================================================================
# FINGERPRINT SPOOFING CONFIGURATION
# =============================================================================
# Default fingerprint settings
DEFAULT_FINGERPRINT_ROTATION_INTERVAL=3600
DEFAULT_BEHAVIOR_SIMULATION_ENABLED=true

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================
# Optional: Add monitoring services
SENTRY_DSN=your_sentry_dsn_here
ANALYTICS_ENABLED=false
